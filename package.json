{
  "name": "NeuroDB",
  "version": "1.0.0",
  "description": "AI-powered PostgreSQL database management tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "electron:dev": "electron . --inspect=5858",
    "dev": "concurrently \"npm run electron:dev\"",
    "build": "electron-builder"
  },
  "keywords": [
    "postgresql",
    "database",
    "ai",
    "electron",
    "sql"
  ],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-icon-builder": "^2.0.1"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@langchain/core": "^0.3.0",
    "@langchain/google-genai": "^0.1.0",
    "dotenv": "^16.3.1",
    "langchain": "^0.3.0",
    "node-sql-parser": "^5.0.0",
    "pg": "^8.11.3",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.neurodb.app",
    "productName": "NeuroDB",
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!**/*.ts",
      "!*.map",
      "build/icons/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/pg/**/*",
      "node_modules/pg-native/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icons",
        "to": "icons",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icons/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "type": "distribution",
      "extendInfo": {
        "CFBundleName": "NeuroDB",
        "CFBundleDisplayName": "NeuroDB",
        "CFBundleIdentifier": "com.neurodb.app",
        "NSAppleEventsUsageDescription": "NeuroDB needs access to control other applications for database management."
      },
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "dmg": {
      "title": "NeuroDB ${version}",
      "icon": "build/icons/icon.icns",
      "background": null,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icons/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NeuroDB"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icons",
      "category": "Development",
      "desktop": {
        "Name": "NeuroDB",
        "Comment": "AI-powered PostgreSQL database management tool",
        "Categories": "Development;Database;"
      },
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
