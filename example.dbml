// Example DBML Schema for E-commerce Database

Table users {
  id integer [pk]
  username varchar
  email varchar [unique]
  created_at timestamp
}

Table products {
  id integer [pk]
  name varchar
  price decimal
  stock integer
  category_id integer [ref: > categories.id]
}

Table categories {
  id integer [pk]
  name varchar
  description text
}

Table orders {
  id integer [pk]
  user_id integer [ref: > users.id]
  total decimal
  status varchar
  created_at timestamp
}

Table order_items {
  id integer [pk]
  order_id integer [ref: > orders.id]
  product_id integer [ref: > products.id]
  quantity integer
  price decimal
}

Table reviews {
  id integer [pk]
  product_id integer [ref: > products.id]
  user_id integer [ref: > users.id]
  rating integer
  comment text
  created_at timestamp
}
